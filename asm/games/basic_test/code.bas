 0  PRINT  CHR$ (4)"BLOAD ENGINE,A$8000"
 1  PRINT  CHR$ (4)"BLOAD CART,A$4000"
 2  CALL 32768
 3  REM ---- cart load: tiles + map from $4000 ----
 4  POKE 624,0: POKE 625,64: CALL 846
 5  REM ---- player start ----
 6 PX = 10:PY = 6
 7  POKE 624,3: POKE 625,PX: POKE 626,PY: CALL 771
 8  CALL 774
 9  REM ---- frame loop ----
 10  CALL 947
 11  CALL 843:DX =  PEEK (624):DY =  PEEK (625)
 12  IF DX > 127 THEN DX = DX - 256
 13  IF DY > 127 THEN DY = DY - 256
 14  IF DX = 0 THEN  IF DY = 0 GOTO 30
 15 NX = PX + DX:NY = PY + DY
 16  IF NX < 1 OR NX > 18 OR NY < 1 OR NY > 10 GOTO 30
 20  POKE 624,2: POKE 625,PX: POKE 626,PY: POKE 627,3: POKE 628,NX: POKE 629,NY: CALL 840
 21 PX = NX:PY = NY
 30  CALL 950
 31  GOTO 10
